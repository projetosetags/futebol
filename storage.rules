rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Apenas o administrador pode consultar e enviar comprovantes.
    match /comprovantes/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == 'RutTVgdXfjdGrFFnbaYmpOO2nJi1';
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
