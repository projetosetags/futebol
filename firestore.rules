rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Acesso administrativo exclusivo ao UID do proprietário do sistema.
    match /appData/current {
      allow read, write: if request.auth != null
        && request.auth.uid == 'RutTVgdXfjdGrFFnbaYmpOO2nJi1';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
