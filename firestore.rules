rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Acesso exclusivo aos administradores cadastrados no painel.
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid == 'RutTVgdXfjdGrFFnbaYmpOO2nJi1'
          || request.auth.uid == 'xptgdFErpMV5Ekxa3CRX2SBrdcy1'
          || request.auth.uid == 'jmJvH0W7uwdCMlUeyJSWnC4Hd103'
          || request.auth.uid == '45AaXndEroRoLYEf1SDFMYBLXZw2'
          || request.auth.token.get('email', '') in ['esli@futebol.com', 'maicon@futebol.com', 'phdbr68@gmail.com']);
    }
    match /appData/current {
      allow read, write: if isAdmin();
    }
    match /notices/{noticeId} {
      allow read: if isAdmin() || request.auth != null;
      allow write: if isAdmin();
    }
    match /polls/{pollId} {
      // Todos os usuários autenticados podem consultar as enquetes; só os administradores as alteram.
      allow read: if isAdmin() || request.auth != null;
      allow write: if isAdmin();
    }
    match /pollVotes/{voteId} {
      function pollPath(pollId) {
        return /databases/$(database)/documents/polls/$(pollId);
      }
      function tallyPath(pollId, optionKey) {
        return /databases/$(database)/documents/pollTallies/$(pollId + '-' + optionKey);
      }
      function voteIsOpen(pollId) {
        let poll = get(pollPath(pollId)).data;
        return !('expiresAt' in poll)
          || poll.expiresAt == ''
          || (('expiresAtMs' in poll) && request.time.toMillis() <= poll.expiresAtMs);
      }
      allow get: if isAdmin() || (request.auth != null && resource.data.voterId == request.auth.uid);
      allow list: if isAdmin() || (request.auth != null && resource.data.voterId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['pollId', 'optionIndex', 'voterId', 'createdAt'])
        && request.resource.data.pollId is string
        && request.resource.data.optionIndex is string
        && request.resource.data.optionIndex.matches('^(0|[1-9][0-9]*)$')
        && request.resource.data.voterId == request.auth.uid
        && request.resource.data.createdAt is string
        && voteId == request.resource.data.pollId + '-' + request.auth.uid
        && exists(pollPath(request.resource.data.pollId))
        && int(request.resource.data.optionIndex) < get(pollPath(request.resource.data.pollId)).data.options.size()
        && voteIsOpen(request.resource.data.pollId)
        && !exists(/databases/$(database)/documents/pollVotes/$(voteId))
        && existsAfter(tallyPath(request.resource.data.pollId, request.resource.data.optionIndex))
        && getAfter(tallyPath(request.resource.data.pollId, request.resource.data.optionIndex)).data.pollId == request.resource.data.pollId
        && getAfter(tallyPath(request.resource.data.pollId, request.resource.data.optionIndex)).data.optionIndex == request.resource.data.optionIndex;
      allow update, delete: if isAdmin();
    }
    match /pollTallies/{tallyId} {
      function pollPath(pollId) {
        return /databases/$(database)/documents/polls/$(pollId);
      }
      function pairedNewVote(pollId, optionKey) {
        let votePath = /databases/$(database)/documents/pollVotes/$(pollId + '-' + request.auth.uid);
        return !exists(votePath)
          && existsAfter(votePath)
          && getAfter(votePath).data.pollId == pollId
          && getAfter(votePath).data.optionIndex == optionKey
          && getAfter(votePath).data.voterId == request.auth.uid;
      }
      function validPollOption(pollId, optionKey) {
        return exists(pollPath(pollId))
          && optionKey is string
          && optionKey.matches('^(0|[1-9][0-9]*)$')
          && int(optionKey) < get(pollPath(pollId)).data.options.size();
      }
      allow read: if isAdmin() || request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['pollId', 'optionIndex', 'count'])
        && request.resource.data.pollId is string
        && request.resource.data.optionIndex is string
        && tallyId == request.resource.data.pollId + '-' + request.resource.data.optionIndex
        && validPollOption(request.resource.data.pollId, request.resource.data.optionIndex)
        && request.resource.data.count == 1
        && pairedNewVote(request.resource.data.pollId, request.resource.data.optionIndex);
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['pollId', 'optionIndex', 'count'])
        && request.resource.data.pollId == resource.data.pollId
        && request.resource.data.optionIndex is string
        && request.resource.data.optionIndex == resource.data.optionIndex
        && tallyId == request.resource.data.pollId + '-' + request.resource.data.optionIndex
        && validPollOption(request.resource.data.pollId, request.resource.data.optionIndex)
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && pairedNewVote(request.resource.data.pollId, request.resource.data.optionIndex);
      allow delete: if isAdmin();
    }
    // Galeria enxuta do jogo: as imagens são comprimidas e cada foto fica em seu documento.
    match /gameGallery/{photoId} {
      allow read: if isAdmin() || request.auth != null;
      allow write: if isAdmin();
    }
    // A lista de candidatos e a janela ficam disponíveis somente a usuários autenticados.
    match /gameAwardBallots/{gameId} {
      allow read: if isAdmin() || request.auth != null;
      allow write: if isAdmin();
    }
    match /gameAwardVotes/{voteId} {
      function ballot() {
        return get(/databases/$(database)/documents/gameAwardBallots/$(request.resource.data.gameId)).data;
      }
      allow get, list: if isAdmin() || request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['gameId', 'teamId', 'candidatePlayerId', 'voterId', 'createdAt'])
        && request.resource.data.gameId is string
        && request.resource.data.teamId in ['team-1', 'team-2', 'team-3']
        && request.resource.data.candidatePlayerId is string
        && request.resource.data.voterId == request.auth.uid
        && voteId == request.resource.data.gameId + '-' + request.resource.data.teamId + '-' + request.auth.uid
        && request.resource.data.createdAt is string
        && ballot().eligibleVoterIds.hasAny([request.auth.uid])
        && ballot().teams[request.resource.data.teamId].candidateIds.hasAny([request.resource.data.candidatePlayerId])
        && request.time >= ballot().opensAt
        && request.time <= ballot().closesAt
        && !exists(/databases/$(database)/documents/gameAwardVotes/$(voteId));
      allow update, delete: if isAdmin();
    }

    // Reserva única por participante; o limite é validado no servidor.
    match /gameRegistrations/{gameId} {
      function profile() {
        return get(/databases/$(database)/documents/playerData/$(request.auth.uid)).data;
      }
      function playerId() { return profile().playerId; }
      function game() {
        return get(/databases/$(database)/documents/gameRosters/$(gameId)).data;
      }
      function openGame() {
        return request.auth != null && profile().approved == true
          && profile().playerId is string
          && game().registrationMode == 'first-confirmed-v1'
          && game().status != 'played' && game().status != 'cancel'
          && request.time.toMillis() <= game().signupClosesAtMs;
      }
      function validNewSlot(slot, keeper, sequence) {
        return slot.keys().hasOnly(['uid', 'playerId', 'name', 'sequence', 'joinedAt'])
          && slot.uid == request.auth.uid && slot.playerId == playerId()
          && slot.name == profile().name && slot.name is string
          && slot.sequence == sequence && slot.sequence is int
          && slot.joinedAt == request.time
          && (keeper ? profile().get('gamePositions', {}).get(gameId, 'Jogador') == 'Goleiro'
            : profile().get('gamePositions', {}).get(gameId, 'Jogador') != 'Goleiro');
      }
      function validSlots(data, oldLines, oldKeepers, oldSequence) {
        let id = playerId();
        let additions = data.lineSlots.diff(oldLines).addedKeys().size() + data.keeperSlots.diff(oldKeepers).addedKeys().size();
        return data.keys().hasOnly(['gameId', 'date', 'version', 'lineCapacity', 'keeperCapacity', 'lineSlots', 'keeperSlots', 'nextSequence', 'updatedAt'])
          && data.gameId == gameId && data.date == game().date && data.version == 1
          && data.lineCapacity == 16 && data.keeperCapacity == 2
          && data.lineSlots is map && data.keeperSlots is map
          && data.lineSlots.size() <= 16 && data.keeperSlots.size() <= 2
          && data.lineSlots.diff(oldLines).affectedKeys().hasOnly([id])
          && data.keeperSlots.diff(oldKeepers).affectedKeys().hasOnly([id])
          && !(id in data.lineSlots && id in data.keeperSlots)
          && data.nextSequence is int && data.nextSequence == oldSequence + (additions > 0 ? 1 : 0)
          && data.updatedAt == request.time
          && (!(id in data.lineSlots) || data.lineSlots[id] == oldLines.get(id, null) || validNewSlot(data.lineSlots[id], false, data.nextSequence))
          && (!(id in data.keeperSlots) || data.keeperSlots[id] == oldKeepers.get(id, null) || validNewSlot(data.keeperSlots[id], true, data.nextSequence));
      }
      allow read: if request.auth != null;
      allow create: if isAdmin() || (openGame() && validSlots(request.resource.data, {}, {}, 0));
      allow update: if isAdmin() || (openGame()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lineSlots', 'keeperSlots', 'nextSequence', 'updatedAt'])
        && validSlots(request.resource.data, resource.data.lineSlots, resource.data.keeperSlots, resource.data.nextSequence));
      allow delete: if isAdmin();
    }

    // Histórico privado e durável; somente peso/altura podem mudar nas primeiras 24 horas.
    match /playerMeasurements/{measurementId} {
      function ownApprovedPlayer(data) {
        let profile = get(/databases/$(database)/documents/playerData/$(request.auth.uid)).data;
        return request.auth != null && profile.approved == true
          && data.uid == request.auth.uid && data.playerId == profile.playerId;
      }
      function validMeasurement(data) {
        return data.keys().hasAll(['uid', 'playerId', 'date', 'weightKg', 'heightM', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['uid', 'playerId', 'date', 'weightKg', 'heightM', 'createdAt', 'updatedAt'])
          && data.uid is string && data.playerId is string
          && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.weightKg is number && data.weightKg > 0 && data.weightKg <= 500
          && data.heightM is number && data.heightM > 0 && data.heightM <= 3
          && data.createdAt is timestamp && data.updatedAt == request.time;
      }
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if validMeasurement(request.resource.data)
        && request.resource.data.createdAt == request.time
        && (isAdmin() || ownApprovedPlayer(request.resource.data));
      allow update: if validMeasurement(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['weightKg', 'heightM', 'updatedAt'])
        && (isAdmin() || (ownApprovedPlayer(resource.data)
          && request.time >= resource.data.createdAt
          && request.time < resource.data.createdAt + duration.value(24, 'h')));
      allow delete: if false;
    }

    match /playerAccessRequests/{uid} {
      allow create: if isAdmin() || (request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['firstName', 'fullName', 'nickname', 'phone', 'createdAt', 'status'])
        && request.resource.data.firstName is string
        && request.resource.data.fullName is string
        && request.resource.data.nickname is string
        && request.resource.data.phone is string
        && request.resource.data.firstName.size() <= 30
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.nickname.size() <= 40
        && request.resource.data.phone.matches('^[0-9]{9,11}$')
        && request.resource.data.createdAt is string
        && request.resource.data.status == 'approved');
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow update: if isAdmin() || (request.auth != null
        && request.auth.uid == uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'approved');
      allow delete: if isAdmin();
    }
    // Índice por hash de nome + telefone local para aceitar login com nome, nome completo ou apelido.
    // O documento contém apenas o e-mail sintético do Firebase, sem expor o telefone.
    match /playerLoginAliases/{aliasId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    // Dados públicos da escalação, sem telefones, pagamentos ou comprovantes.
    match /gameRosters/{gameId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
    match /playerData/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid && resource.data.approved == true);
      allow create: if isAdmin() || (request.auth != null
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/playerAccessRequests/$(uid))
        && get(/databases/$(database)/documents/playerAccessRequests/$(uid)).data.status == 'approved'
        && request.resource.data.keys().hasOnly(['name', 'nickname', 'phone', 'approved', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'nickname', 'phone', 'approved', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 40
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9]{9,11}$')
        && request.resource.data.approved == true
        && request.resource.data.createdAt is string);
      allow delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null
        && request.auth.uid == uid
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendanceChoices'])
          && request.resource.data.attendanceChoices is map
          && request.resource.data.attendanceChoices.keys().size() <= 30
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'displayNickname'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 100
          && request.resource.data.displayNickname is string
          && request.resource.data.displayNickname.size() <= 40));
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

